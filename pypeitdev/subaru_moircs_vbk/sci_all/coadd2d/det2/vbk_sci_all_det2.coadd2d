# Paths are relative to the directory of this file; run the
# command from there.
# VB_K mask MO_CC0958PA200_1: 2D coadd of the 32 science frames
# (16 A-B pairs, A-B and B-A), DET02; header dither offsets
[rdx]
  spectrograph = subaru_moircs
  detnum = 2

[coadd2d]
  offsets = header
  weights = uniform

spec2d read
