# User-defined execution parameters
[rdx]
    spectrograph = keck_hires_orig
[calibrations]
    [[slitedges]]
        pad = 8,6
    [[flatfield]]
        tweak_slits = False
        slit_trim = 0.0
[reduce]
    [[skysub]]
        max_mask_frac = 0.9

# Setup
setup read
Setup D:
  binning: 2,1
  decker: C5
  dispname: RED
  echangle: 0.0
  filter1: clear
  xdangle: -0.81300002
setup end

