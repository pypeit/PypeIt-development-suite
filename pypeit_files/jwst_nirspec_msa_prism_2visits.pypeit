# User-defined execution parameters
[rdx]
    spectrograph = jwst_nirspec
    # Bright source observed in both visits 001 and 003 (slit 258 in visit 001 and
    # slit 260 in visit 003), used to test the 2D coadd of exposures taken in
    # different visits (see coadd2d_files/jwst_nirspec_msa_prism_2visits.coadd2d)
    maskIDs = 178562
[reduce]
    [[findobj]]
      snr_thresh = 1.2
      skip_skysub = True
    [[extraction]]
      boxcar_radius = 0.3
    [[skysub]]
      local_maskwidth = 3.

# Setup
setup read
Setup A:
  decker: NRS_FULL_MSA
  dispname: PRISM
  filter1: CLEAR
  target: GOODS-South
setup end

# Data block 
# PID 1287 (GOODS-South), MSA PRISM/CLEAR.  Visit 001 (jw01287001001_*) was observed on
# 2024-01-11 and visit 003 (jw01287001003_*) on 2024-01-12.  For each visit, the three
# nodded exposures of dither group 11101 are included.  Only NRS1 is used, because
# source 178562 falls on that detector in both visits.
data read
 path MSA_PRISM_2visits
