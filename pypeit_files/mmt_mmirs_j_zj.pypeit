# Auto-generated PypeIt file (regenerated for the geometry-driven A-B nod
# pairing and the derived dither columns)

# User-defined execution parameters
[rdx]
    spectrograph = mmt_mmirs
[reduce]
    [[findobj]]
        snr_thresh = 50.

# Setup
setup read
Setup A:
  decker: 4pixel-long
  dichroic: zJ
  dispname: J
setup end

